# Local development only. No API credentials are required for the health API.
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:3001","http://localhost:3001"]

# Typesense is server-side only. Use a locally generated development key.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION=afyaher_knowledge_v2
TYPESENSE_TIMEOUT_SECONDS=3

# Optional development-only hosted research. Export privately in the script's
# environment; this CLI does not automatically load .env. Never use coding-agent
# credentials here. Choose a current :free model and a reviewed provider endpoint.
AFYAHER_RESEARCH_API_KEY=
AFYAHER_RESEARCH_MODEL=
AFYAHER_RESEARCH_PROVIDER=
