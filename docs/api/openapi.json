{
  "components": {
    "schemas": {
      "AnswerStatus": {
        "enum": [
          "answered",
          "insufficient_evidence",
          "clarification_needed",
          "out_of_scope",
          "urgent_guidance",
          "service_unavailable"
        ],
        "title": "AnswerStatus",
        "type": "string"
      },
      "CatalogueSource": {
        "additionalProperties": false,
        "properties": {
          "clinical_review_status": {
            "$ref": "#/components/schemas/ClinicalReviewStatus"
          },
          "content_scope": {
            "$ref": "#/components/schemas/ContentScope"
          },
          "id": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Id",
            "type": "string"
          },
          "ingestion_permission": {
            "$ref": "#/components/schemas/IngestionPermission"
          },
          "ingestion_status": {
            "$ref": "#/components/schemas/IngestionStatus"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "topic": {
            "$ref": "#/components/schemas/Topic"
          },
          "url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "topic",
          "title",
          "publisher",
          "url",
          "clinical_review_status",
          "ingestion_permission",
          "ingestion_status",
          "content_scope"
        ],
        "title": "CatalogueSource",
        "type": "object"
      },
      "ClinicalReviewStatus": {
        "enum": [
          "not_reviewed",
          "in_review",
          "approved",
          "rejected"
        ],
        "title": "ClinicalReviewStatus",
        "type": "string"
      },
      "ContentScope": {
        "enum": [
          "development_only",
          "production"
        ],
        "title": "ContentScope",
        "type": "string"
      },
      "EducationalRequest": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "description": "A question containing at least 3 non-whitespace characters",
            "maxLength": 2000,
            "title": "Question",
            "type": "string"
          },
          "topic": {
            "$ref": "#/components/schemas/Topic"
          }
        },
        "required": [
          "topic",
          "question"
        ],
        "title": "EducationalRequest",
        "type": "object"
      },
      "EducationalResponse": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "disclaimer": {
            "const": "This is educational information, not medical advice. Consult a qualified clinician for personal health decisions.",
            "default": "This is educational information, not medical advice. Consult a qualified clinician for personal health decisions.",
            "title": "Disclaimer",
            "type": "string"
          },
          "limitations": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explicit limitation or abstention when evidence is insufficient",
            "title": "Limitations"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceReference"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/AnswerStatus"
          },
          "topic": {
            "$ref": "#/components/schemas/Topic"
          }
        },
        "required": [
          "status",
          "topic",
          "question",
          "answer",
          "sources"
        ],
        "title": "EducationalResponse",
        "type": "object"
      },
      "EvidenceSufficiency": {
        "enum": [
          "not_assessed",
          "insufficient"
        ],
        "title": "EvidenceSufficiency",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "const": "afyaher-api",
            "default": "afyaher-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "IngestionPermission": {
        "enum": [
          "not_verified",
          "permitted",
          "prohibited"
        ],
        "title": "IngestionPermission",
        "type": "string"
      },
      "IngestionStatus": {
        "enum": [
          "metadata_only",
          "ingested"
        ],
        "title": "IngestionStatus",
        "type": "string"
      },
      "KnowledgeSearchHit": {
        "additionalProperties": false,
        "properties": {
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "passage": {
            "title": "Passage",
            "type": "string"
          },
          "publication_date": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publication Date"
          },
          "score": {
            "description": "Search ranking only; not evidence strength",
            "minimum": 0.0,
            "title": "Score",
            "type": "integer"
          },
          "section": {
            "title": "Section",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "source_title": {
            "title": "Source Title",
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          },
          "topic": {
            "$ref": "#/components/schemas/Topic"
          }
        },
        "required": [
          "id",
          "source_id",
          "source_title",
          "source_url",
          "topic",
          "section",
          "passage",
          "publication_date",
          "score",
          "content_hash"
        ],
        "title": "KnowledgeSearchHit",
        "type": "object"
      },
      "KnowledgeSearchRequest": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 5,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "question": {
            "description": "A question containing at least 3 non-whitespace characters",
            "maxLength": 2000,
            "title": "Question",
            "type": "string"
          },
          "topic": {
            "$ref": "#/components/schemas/Topic"
          }
        },
        "required": [
          "topic",
          "question"
        ],
        "title": "KnowledgeSearchRequest",
        "type": "object"
      },
      "KnowledgeSearchResponse": {
        "additionalProperties": false,
        "properties": {
          "evidence_sufficiency": {
            "$ref": "#/components/schemas/EvidenceSufficiency"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeSearchHit"
            },
            "title": "Passages",
            "type": "array"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "$ref": "#/components/schemas/RetrievalStatus"
          },
          "topic": {
            "$ref": "#/components/schemas/Topic"
          }
        },
        "required": [
          "status",
          "topic",
          "evidence_sufficiency",
          "passages"
        ],
        "title": "KnowledgeSearchResponse",
        "type": "object"
      },
      "RetrievalStatus": {
        "enum": [
          "candidates_found",
          "no_matching_evidence",
          "retrieval_unavailable"
        ],
        "title": "RetrievalStatus",
        "type": "string"
      },
      "SourceCatalogue": {
        "additionalProperties": false,
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/CatalogueSource"
            },
            "title": "Sources",
            "type": "array"
          },
          "topic": {
            "$ref": "#/components/schemas/Topic"
          }
        },
        "required": [
          "topic",
          "sources"
        ],
        "title": "SourceCatalogue",
        "type": "object"
      },
      "SourceReference": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "publisher",
          "url"
        ],
        "title": "SourceReference",
        "type": "object"
      },
      "Topic": {
        "enum": [
          "pcos",
          "ovarian-cysts",
          "ovarian-torsion"
        ],
        "title": "Topic",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Private reproductive-health education engineering prototype for adults 18+. Use synthetic inputs only. This API does not diagnose, assess symptoms, provide treatment, or perform emergency screening.\n\nThe education endpoint remains an unavailable stub. The separate knowledge search endpoint returns only provenance-checked approved passage candidates; it does not generate answers or assess claim support. Health reports liveness only.\n\nThese docs do not establish clinical validation or approval for public use. Do not enter real health information or secrets.",
    "title": "AfyaHer private prototype API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/education/ask": {
      "post": {
        "description": "Accept an educational question and return a stub response.\n\nNo AI provider, retrieval pipeline, or safety screening is connected.\nEvery question receives an explicit service-unavailable status\nuntil the retrieval and generation layers are implemented.",
        "operationId": "ask_api_v1_education_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "synthetic_cysts": {
                  "summary": "Synthetic ovarian-cysts routing example",
                  "value": {
                    "question": "Another fictional request for an API test.",
                    "topic": "ovarian-cysts"
                  }
                },
                "synthetic_pcos": {
                  "summary": "Synthetic PCOS routing example (not medical content)",
                  "value": {
                    "question": "A synthetic educational question for testing.",
                    "topic": "pcos"
                  }
                },
                "synthetic_torsion": {
                  "summary": "Synthetic ovarian-torsion routing example",
                  "value": {
                    "question": "A fictional topic-routing request for testing.",
                    "topic": "ovarian-torsion"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/EducationalRequest",
                "description": "Only topic and question are accepted. The question must be a string; leading/trailing whitespace is removed before checking at least three non-whitespace characters and at most 2,000 total characters. Do not send identifying information or real health questions."
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "answer": "Educational answers are not available yet.",
                  "disclaimer": "This is educational information, not medical advice. Consult a qualified clinician for personal health decisions.",
                  "limitations": "The evidence-backed answer service is not implemented.",
                  "question": "A synthetic educational question for testing.",
                  "sources": [],
                  "status": "service_unavailable",
                  "topic": "pcos"
                },
                "schema": {
                  "$ref": "#/components/schemas/EducationalResponse"
                }
              }
            },
            "description": "HTTP 200 with application status service_unavailable; no medical answer or citations. This is not an HTTP 503 response."
          },
          "405": {
            "description": "The requested method is not supported by this path."
          },
          "422": {
            "description": "Request validation failed: unsupported topic, wrong types, missing or extra fields, fewer than three non-whitespace characters, or more than 2,000 characters after trimming. Framework errors may echo input values; use synthetic data only."
          }
        },
        "summary": "Validate an educational question (unavailable stub)",
        "tags": [
          "education"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "API liveness only; does not report database or AI readiness.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "service": "afyaher-api",
                  "status": "ok"
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "The API process can respond; no database or AI checks occur.",
            "headers": {
              "Cache-Control": {
                "description": "Prevent caching of liveness results.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Check API liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/knowledge/search": {
      "post": {
        "description": "Searches Typesense with an exact topic filter and returns provenance-checked passage candidates. A search match is not claim-support validation. Empty results abstain; Typesense failures return retrieval_unavailable. No LLM is called.",
        "operationId": "search_knowledge_api_v1_knowledge_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KnowledgeSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeSearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeSearchResponse"
                }
              }
            },
            "description": "Retrieval unavailable"
          }
        },
        "summary": "Search approved passages without generating an answer",
        "tags": [
          "knowledge"
        ]
      }
    },
    "/api/v1/knowledge/sources": {
      "get": {
        "description": "Returns local registry metadata only, including unreviewed candidates. Listing is not ingestion permission, clinical approval or claim support. No publisher download, passage retrieval or LLM call occurs. Supported topics without a registry return an empty list.",
        "operationId": "sources_api_v1_knowledge_sources_get",
        "parameters": [
          {
            "in": "query",
            "name": "topic",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Topic"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceCatalogue"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Source catalogue unavailable"
          }
        },
        "summary": "List source metadata and review status",
        "tags": [
          "knowledge"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Source metadata and passage retrieval candidates; a search match is not evidence sufficiency or claim support.",
      "name": "knowledge"
    },
    {
      "description": "API liveness, not clinical readiness.",
      "name": "health"
    },
    {
      "description": "Validated educational requests; currently unavailable.",
      "name": "education"
    }
  ]
}
